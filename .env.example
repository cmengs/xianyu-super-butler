# Web service
WEB_BIND=0.0.0.0
WEB_PORT=28080
TZ=Asia/Shanghai

# External MySQL.
# If MySQL runs on the same Ubuntu host as Docker, keep host.docker.internal.
# If MySQL runs on another machine, set DB_HOST to that machine's LAN IP.
DB_TYPE=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=xianyu_super_butler
DB_USERNAME=root
DB_PASSWORD=change-me-please

# Admin and security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=change-this-jwt-secret

# noVNC for Docker captcha handling.
# Keep 127.0.0.1 for SSH tunnel access. Use 0.0.0.0 only on a trusted LAN.
ENABLE_NOVNC=true
FORCE_HEADFUL_IN_DOCKER=true
NOVNC_BIND=0.0.0.0
NOVNC_PORT=26080
NOVNC_PUBLIC_PORT=26080
VNC_BIND=127.0.0.1
VNC_PORT=5900
VNC_PASSWORD=xianyu
SCREEN_WIDTH=1365
SCREEN_HEIGHT=768
SCREEN_DEPTH=24

# Runtime
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true
MEMORY_LIMIT=3072
CPU_LIMIT=2.0
